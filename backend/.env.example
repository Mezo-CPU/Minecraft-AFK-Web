# Copy this to .env (or set these in Bot-Hosting.net's "Variables" panel).

# Port the bot server listens on. Bot-Hosting.net usually assigns this for
# you automatically via its own PORT variable — check your panel's "Network"
# tab for the exact port it exposes before overriding this.
PORT=25580

# Shared secret the web dashboard must present to connect. Without this set,
# ANYONE who finds your server's address can control your Minecraft accounts.
# Generate a long random string, e.g.: openssl rand -hex 32
ACCESS_TOKEN=change-me-to-something-long-and-random
